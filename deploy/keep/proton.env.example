# Copy to proton.env (same folder) and fill in. proton.env holds a secret and is
# git-ignored: never commit it, never paste it into chat.

# 1. Sign in at account.protonvpn.com -> Downloads -> WireGuard configuration.
# 2. Pick a P2P server near you (port forwarding only works on P2P servers).
# 3. Tick "NAT-PMP (Port Forwarding)" under "Select VPN options".
# 4. Create the config and copy the PrivateKey line's value here.
# Port forwarding needs a paid Proton plan.
WIREGUARD_PRIVATE_KEY=replace-with-the-PrivateKey-value

# Optional: where the exit should be. Comma separated; leave empty for any P2P server.
# Names are Proton's, e.g. Netherlands, Switzerland.
SERVER_COUNTRIES=
SERVER_CITIES=

# Your home network, so the status page (port 8780) can answer devices on it.
# Without this the replies would go back into the VPN. Change it if your home
# network is not 192.168.x.x, and keep it clear of 10.2.0.0/24 (Proton's tunnel).
FIREWALL_OUTBOUND_SUBNETS=192.168.0.0/16
